#ifndef TEST_PATH_HPP
#define TEST_PATH_HPP

#include <filesystem>

namespace test::paths {

const std::filesystem::path test_output_path{"@TEST_OUTPUT_PATH@"};
const std::filesystem::path dynlib_output_path{"@DYNLIB_OUTPUT_PATH@"};

inline std::filesystem::path get_dynlib_path() {
#ifdef _WIN32
    const std::string dynlib_extension{".dll"};
#else
    const std::string dynlib_extension{".so"};
#endif

    for (const auto &dir_entry :
         std::filesystem::directory_iterator{dynlib_output_path}) {
        if (!dir_entry.is_regular_file()) {
            continue;
        }

        if (dir_entry.path().string().find("dynlib" + dynlib_extension) !=
            std::string::npos) {
            return dir_entry.path();
        }
    }

    throw std::runtime_error("Cannot find dynlib binary");
}

} // namespace test::paths

#endif
